@model MediGrids.Models.TerapeutaEjercicioViewModel

@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Editar Ejercicio";
}

<section class="container">

    <div class="agendar-citas-header">
        <h1><i class="lni lni-pencil"></i> Editar Ejercicio</h1>
        <p>Modifique la informacion del ejercicio</p>
    </div>

    <div class="step-wizard">
        <div class="form-section">

            @using (Html.BeginForm("Editar", "Terapeuta", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                
                @Html.HiddenFor(m => m.id_ejercicio)

                
                <div class="form-group mb-3">
                    <label>Nombre</label>
                    @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", required = "required" })
                </div>

                
                <div class="form-group mb-3">
                    <label>Descripcion</label>
                    @Html.TextAreaFor(m => m.descripcion, new { @class = "form-control", rows = 3 })
                </div>

                
                <div class="form-group mb-3">
                    <label>Objetivo</label>
                    @Html.TextAreaFor(m => m.objetivo, new { @class = "form-control", rows = 3 })
                </div>

                
                <div class="form-group mb-3">
                    <label>Dificultad</label>
                    @Html.TextBoxFor(m => m.dificultad, new { @class = "form-control" })
                </div>

                
                <div class="form-group mb-3">
                    <label>Video URL</label>
                    @Html.TextBoxFor(m => m.video_url, new { @class = "form-control" })
                </div>

                
                <div class="form-group mb-3">
                    <label>Id Terapia</label>
                    @Html.TextBoxFor(m => m.id_terapia, new { @class = "form-control" })
                </div>

                
                <div class="form-group mb-3">
                    <label>Id Categoria</label>
                    @Html.TextBoxFor(m => m.id_categoria, new { @class = "form-control" })
                </div>

                
                <div class="d-flex justify-content-end gap-2 mt-4">

                    
                    <a href="@Url.Action("GestionarEjercicio", "Terapeuta")"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    
                    <button type="submit" class="btn btn-primary">
                        <i class="lni lni-save"></i> Guardar Cambios
                    </button>

                </div>
            }

        </div>
    </div>

</section>