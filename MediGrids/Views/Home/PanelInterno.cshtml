@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Panel Interno";
}

<link rel="stylesheet" href="~/Template/css/panelinterno.css" />

<section class="container">
    <div class="panel-hero">
        <h1>Gestión Administrativa</h1>
        <p>Bienvenido a MediGrids. Desde aquí puede acceder a los módulos internos del sistema.</p>
    </div>

    <div class="row g-4">
     

            <div class="col-lg-4 col-md-6 col-12">
            <div class="panel-card">
                <div class="panel-icon"><i class="lni lni-users"></i></div>
                <h4>Gestión de Terapeutas</h4>
                <p>Administra el registro, edición, activación y consulta de terapeutas.</p>
                <a href='@Url.Action("Index", "GestionTerapeuta")' class="btn btn-success">Ingresar</a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
            <div class="panel-card">
                <div class="panel-icon"><i class="lni lni-cog"></i></div>
                <h4>Roles y Permisos</h4>
                <p>Configura permisos por rol y administra el acceso a las funcionalidades del sistema.</p>
                <a href='@Url.Action("GestionarRoles", "Rol")' class="btn btn-success">Ingresar</a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
            <div class="panel-card">
                <div class="panel-icon"><i class="lni lni-user"></i></div>
                <h4>Pacientes</h4>
                <p>Consulta y administra la información general de los pacientes registrados.</p>
                <a href='@Url.Action("GestionarPacientes", "GestionarPacientes")' class="btn btn-success">Ingresar</a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
            <div class="panel-card">
                <div class="panel-icon"><i class="lni lni-layout"></i></div>
                <h4>Asignación de Ejercicios</h4>
                <p>Permite asignar ejercicios a pacientes según terapia o tratamiento.</p>
                <a href='@Url.Action("AsignacionEjercicios", "Terapeuta")' class="btn btn-success">Ingresar</a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
            <div class="panel-card">
                <div class="panel-icon"><i class="lni lni-calendar"></i></div>
                <h4>Agendar Cita</h4>
                <p>Gestiona el proceso de reservación y consulta de citas dentro del sistema.</p>
                <a href='@Url.Action("AgendarCitas", "Paciente")' class="btn btn-success">Ingresar</a>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 col-12">
            <div class="panel-card">
                <div class="panel-icon"><i class="lni lni-grid-alt"></i></div>
                <h4>Gestión de Ejercicios</h4>
                <p>Administra, crea, edita y elimina ejercicios terapéuticos del sistema.</p>
                <a href='@Url.Action("GestionarEjercicio", "Terapeuta")' class="btn btn-success">Ingresar</a>
            </div>
        </div>

    </div>
</section>