<!DOCTYPE html>
<html class="no-js" lang="zxx">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>@ViewBag.Title - MediGrids</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="shortcut icon" href="~/Template/images/favicon.svg" />

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">

    <!-- CSS base -->
    <link rel="stylesheet" href="~/Template/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Template/css/LineIcons.2.0.css" />
    <link rel="stylesheet" href="~/Template/css/animate.css" />
    <link rel="stylesheet" href="~/Template/css/tiny-slider.css" />
    <link rel="stylesheet" href="~/Template/css/glightbox.min.css" />
    <link rel="stylesheet" href="~/Template/css/main.css" />

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" />

    <style>
        .internal-page-wrapper {
            padding-top: 140px;
            padding-bottom: 40px;
        }
    </style>
</head>

<body>

    <!-- Loader -->
    <div class="preloader">
        <div class="preloader-inner">
            <div class="preloader-icon">
                <span></span>
                <span></span>
            </div>
        </div>
    </div>

    <!-- HEADER -->
    <header class="header navbar-area">
        <div class="container">
            <div class="nav-inner">
                <nav class="navbar navbar-expand-lg">

                    <!-- LOGO -->
                    <a class="navbar-brand" href="@Url.Action("PanelInterno", "Home")">
                        <img src="~/Template/images/logo/logo.svg" />
                    </a>

                    <!-- MENU -->
                    <div class="collapse navbar-collapse sub-menu-bar" id="navbarSupportedContent">
                        <ul id="nav" class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a href="@Url.Action("PanelInterno","Home")">Inicio</a>
                            </li>

                    
                            <li class="nav-item">
                                <a href="@Url.Action("Index","GestionTerapeuta")">Gestión De Terapeutas</a>
                            </li>

                            <li class="nav-item">
                                <a href="javascript:void(0)">Roles Y Permisos</a>
                            </li>

                            <li class="nav-item">
                                <a href="javascript:void(0)">Pacientes</a>
                            </li>

                            <li class="nav-item">
                                <a href="@Url.Action("AsignacionEjercicios","Terapeuta")">Asignación Ejercicios</a>
                            </li>

                        
                        </ul>
                    </div>

                    <!-- LOGOUT -->
                    <div class="button">
                        <a href="@Url.Action("Index","Home")" class="btn">Cerrar sesión</a>
                    </div>

                </nav>
            </div>
        </div>
    </header>

    <!-- BODY -->
    <div class="internal-page-wrapper">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="footer overlay">
        <div class="container">
            <p style="color:white;">MediGrids - Panel interno</p>
        </div>
    </footer>

    <!-- JS BASE -->
    <script src="~/Template/js/bootstrap.min.js"></script>
    <script src="~/Template/js/wow.min.js"></script>
    <script src="~/Template/js/tiny-slider.js"></script>
    <script src="~/Template/js/glightbox.min.js"></script>
    <script src="~/Template/js/count-up.min.js"></script>
    <script src="~/Template/js/imagesloaded.min.js"></script>
    <script src="~/Template/js/isotope.min.js"></script>
    <script src="~/Template/js/main.js"></script>

    <!-- Bundles -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("Scripts", required: false)

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.bootstrap5.js"></script>

</body>
</html>