@model List<MediGrids.Models.MisEjerciciosAsignadosViewModel>

@{
    ViewBag.Title = "Mis Ejercicios Asignados";
    Layout = "~/Views/Shared/_LayoutPaciente.cshtml";
}

<link rel="stylesheet" href="~/Template/css/panelpacientes.css" />

<section class="paciente-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1>Mis Ejercicios Asignados</h1>
                <p>
                    Aquí puede consultar los ejercicios que han sido asignados a su tratamiento.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="paciente-section">
    <div class="container">
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="paciente-card">
                <h4>No tiene ejercicios asignados</h4>
                <p>Por el momento no se encontraron ejercicios vinculados a su perfil.</p>
                <a href="@Url.Action("PanelPaciente", "Home")" class="btn btn-secondary">Volver al panel</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var ejercicio in Model)
                {
                    <div class="col-lg-6 col-md-6 col-12">
                        <div class="paciente-card">
                            <div class="paciente-icon">
                                <i class="lni lni-list"></i>
                            </div>

                            <h4>@ejercicio.NombreEjercicio</h4>

                            <p>
                                <strong>Descripción:</strong>
                                @(string.IsNullOrWhiteSpace(ejercicio.Descripcion) ? "Sin descripción registrada." : ejercicio.Descripcion)
                            </p>

                            <p>
                                <strong>Fecha de asignación:</strong>
                                @(ejercicio.FechaAsignacion.HasValue
                                    ? ejercicio.FechaAsignacion.Value.ToString("dd/MM/yyyy HH:mm")
                                    : "No registrada")
                            </p>

                            <p>
                                <strong>Estado:</strong>
                                @ejercicio.Estado
                            </p>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4">
                <a href="@Url.Action("PanelPaciente", "Home")" class="btn btn-secondary">Volver al panel</a>
            </div>
        }
    </div>
</section>