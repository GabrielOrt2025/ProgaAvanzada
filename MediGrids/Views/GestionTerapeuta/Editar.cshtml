@model MediGrids.Models.GestionTerapeutaViewModel
@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Editar Terapeuta";
    var categorias = ViewBag.Categorias as List<MediGrids.EntityFramework.CategoriaClinica>;
}

<link rel="stylesheet" href="~/Template/css/ejercicios.css" />

<section class="container">
    <div class="agendar-citas-header">
        <h1><i class="lni lni-pencil"></i> Editar Terapeuta</h1>
        <p>Modifique los datos del terapeuta (RF-09.3)</p>
    </div>

    <div class="step-wizard">
        <div class="form-section">

            @using (Html.BeginForm("GuardarEdicion", "GestionTerapeuta", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IdTerapeuta)
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group mb-3">
                    <label>Usuario (solo lectura)</label>
                    <input type="text" class="form-control" value="@Model.Username" readonly disabled />
                    <small class="text-muted">El usuario de login no se puede cambiar desde aqui.</small>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Nombre)
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Apellidos)
                            @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Telefono)
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Email)
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.IdCategoria)
                            <select name="IdCategoria" id="IdCategoria" class="form-control">
                                <option value="">-- Sin especialidad --</option>
                                @if (categorias != null)
                                {
                                    foreach (var c in categorias)
                                    {
                                        <option value="@c.id_categoria" @(Model.IdCategoria == c.id_categoria ? "selected" : "")>@c.nombre (@(c.TipoTerapia?.nombre ?? ""))</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <span class="badge @(Model.Activo ? "badge-activo" : "badge-inactivo") p-2">
                        Estado actual: @(Model.Activo ? "Activo" : "Inactivo")
                    </span>
                    <small class="d-block text-muted mt-1">Para activar/desactivar use el boton en la lista de terapeutas.</small>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="@Url.Action("Index", "GestionTerapeuta")" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="lni lni-save"></i> Guardar Cambios
                    </button>
                </div>
            }

        </div>
    </div>
</section>
