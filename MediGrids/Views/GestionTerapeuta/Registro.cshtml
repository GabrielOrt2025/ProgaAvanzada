@model MediGrids.Models.RegistroTerapeutaViewModel
@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Registrar Terapeuta";
    var categorias = ViewBag.Categorias as List<MediGrids.EntityFramework.CategoriaClinica>;
}

<link rel="stylesheet" href="~/Template/css/ejercicios.css" />

<section class="container">
    <div class="agendar-citas-header">
        <h1><i class="lni lni-user-plus"></i> Registrar Terapeuta</h1>
        <p>Complete los datos del nuevo terapeuta y sus credenciales de acceso (RF-09.1)</p>
    </div>

    <div class="step-wizard">
        <div class="form-section">

            @using (Html.BeginForm("Crear", "GestionTerapeuta", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <h3><i class="lni lni-key"></i> Credenciales de acceso</h3>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.UsernameRegistro)
                            @Html.TextBoxFor(m => m.UsernameRegistro, new { @class = "form-control", placeholder = "Ej: terapeuta2" })
                            @Html.ValidationMessageFor(m => m.UsernameRegistro, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Password)
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.ConfirmarPassword)
                            @Html.PasswordFor(m => m.ConfirmarPassword, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.ConfirmarPassword, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <h3 class="mt-4"><i class="lni lni-user"></i> Datos personales</h3>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Nombre)
                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Apellidos)
                            @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control", required = "required" })
                            @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Telefono)
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Email)
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.IdCategoria)
                            <select name="IdCategoria" id="IdCategoria" class="form-control">
                                <option value="">-- Seleccione especialidad --</option>
                                @if (categorias != null)
                                {
                                    foreach (var c in categorias)
                                    {
                                        <option value="@c.id_categoria" @(Model.IdCategoria == c.id_categoria ? "selected" : "")>@c.nombre (@(c.TipoTerapia?.nombre ?? ""))</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="@Url.Action("Index", "GestionTerapeuta")" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="lni lni-save"></i> Registrar Terapeuta
                    </button>
                </div>
            }

        </div>
    </div>
</section>
