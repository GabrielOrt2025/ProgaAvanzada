@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Roles y Permisos";
    var obtenerUsuarios = ViewBag.obtenerUsuarios as List<MediGrids.Models.RolesViewModel>;
}

<link rel="stylesheet" href="~/Template/css/ejercicios.css" />

<section class="container">
    <div class="agendar-citas-header">
        <h1><i class="lni lni-cog"></i> Roles y Permisos</h1>
        <p>Administre los roles y el acceso de los usuarios del sistema</p>
    </div>

    <div class="step-wizard">
        <div class="form-section ejercicios-section">

            <div class="ejercicios-header-actions">
                <div>
                    <h3><i class="lni lni-list"></i> Usuarios del Sistema</h3>
                    <p class="ejercicios-subtitle">
                        Modifique el rol de cada usuario o cambie su estado de acceso.
                    </p>
                </div>
            </div>

            @if (obtenerUsuarios != null && obtenerUsuarios.Any())
            {
                <div class="ejercicios-grid">
                    @foreach (var item in obtenerUsuarios)
                    {
                        <div class="ejercicio-card">

                            <div class="ejercicio-card-header">
                                <div class="ejercicio-badge">
                                    Usuario #@item.id_usuario
                                </div>
                                <h4>@item.correo</h4>
                            </div>

                            <div class="ejercicio-card-body">

                                <div class="ejercicio-meta">
                                    <div class="meta-box" style="grid-column: span 2;">
                                        <span class="label">Rol actual</span>
                                        <span class="value">@item.nombre_rol</span>
                                    </div>
                                    <div class="meta-box" style="grid-column: span 2;">
                                        <span class="label">Estado</span>
                                        @if (item.activo == true)
                                        {
                                            <span class="value" style="color: #0c7a3e; font-weight: 600;">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="value" style="color: #dc3545; font-weight: 600;">Inactivo</span>
                                        }
                                    </div>
                                </div>


                                @using (Html.BeginForm("CambiarRol", "Rol", FormMethod.Post, new { @class = "form-cambiar-rol" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.id_usuario" />
                                    <div class="form-group" style="margin-bottom: 8px;">
                                        <label style="font-size:0.78rem; color:#0c7a3e; font-weight:bold;">Cambiar Rol</label>
                                        <div style="display:flex; gap:8px; align-items:center;">
                                            <select name="nuevoRol" class="form-control" style="flex:1; font-size:0.85rem;">
                                                <option value="1" @(item.id_rol == 1 ? "selected" : "")>Administrador</option>
                                                <option value="2" @(item.id_rol == 2 ? "selected" : "")>Terapeuta</option>
                                                <option value="3" @(item.id_rol == 3 ? "selected" : "")>Paciente</option>
                                            </select>
                                            <button type="submit" class="btn-accion btn-editar" style="width:auto; padding: 8px 12px; white-space:nowrap;">
                                                <i class="lni lni-save"></i> Guardar
                                            </button>
                                        </div>
                                    </div>
                                }

                        
                                @using (Html.BeginForm("ToggleActivo", "Rol", new { id = item.id_usuario }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    if (item.activo == true)
                                    {
                                        <button type="submit"
                                                class="btn-accion btn-desactivar"
                                                style="width:100%;"
                                                onclick="return confirm('¿Desea desactivar este usuario?');">
                                            <i class="lni lni-close"></i> Desactivar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn-accion btn-activar"
                                                style="width:100%;"
                                                onclick="return confirm('¿Desea activar este usuario?');">
                                            <i class="lni lni-checkmark"></i> Activar
                                        </button>
                                    }
                                }

                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state-ejercicios">
                    <i class="lni lni-users"></i>
                    <p>No hay usuarios registrados en este momento.</p>
                </div>
            }

        </div>
    </div>
</section>