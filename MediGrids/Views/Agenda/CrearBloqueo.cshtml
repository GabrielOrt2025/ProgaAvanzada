@using MediGrids.Models
@model MediGrids.Models.AgendaBloqueoViewModel

@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
    ViewBag.Title = "Bloquear Horario";
}

<link rel="stylesheet" href="~/Template/css/AgendarCitas.css" />

<section class="container">
    <div class="agendar-citas-header">
        <h1><i class="lni lni-lock"></i> Bloquear Horario</h1>
        <p>Seleccione la fecha y el rango de horas que desea bloquear en su agenda.</p>
    </div>

    <div class="step-wizard">
        <div class="form-section">

            @using (Html.BeginForm("CrearBloqueo", "Agenda", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @Html.ValidationSummary(false)
                    </div>
                }

                <div class="form-grid">

                    <div class="form-group">
                        <label>Fecha</label>
                        @Html.TextBoxFor(m => m.fecha, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.fecha, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Hora de inicio</label>
                        @Html.TextBoxFor(m => m.hora_inicio, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                        @Html.ValidationMessageFor(m => m.hora_inicio, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Hora de fin</label>
                        @Html.TextBoxFor(m => m.hora_fin, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                        @Html.ValidationMessageFor(m => m.hora_fin, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Motivo (opcional)</label>
                        @Html.TextBoxFor(m => m.motivo, new { @class = "form-control", placeholder = "Ej: Reunión, Almuerzo, Permiso..." })
                        @Html.ValidationMessageFor(m => m.motivo, "", new { @class = "text-danger" })
                    </div>

                </div>

                <div class="ejercicio-actions" style="margin-top: 20px;">
                    <button type="submit" class="btn-accion btn-editar">
                        <i class="lni lni-lock"></i> Guardar Bloqueo
                    </button>
                    <a href="@Url.Action("GestionarAgendaTerapeuta", "Agenda")" class="btn-accion btn-eliminar">
                        <i class="lni lni-arrow-left"></i> Cancelar
                    </a>
                </div>
            }

        </div>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
