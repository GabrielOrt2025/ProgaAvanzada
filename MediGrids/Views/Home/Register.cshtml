@{
    ViewBag.Title = "Registro";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Template/css/register.css")" />

<div class="rg-breadcrumbs">
    <div class="container rg-inner">
        <h1 class="rg-title-top">Registro</h1>
        <div class="rg-crumb">
            <a href="@Url.Action("Index","Home")">Inicio</a>
            &nbsp;>&nbsp;
            <span>Registro</span>
        </div>
    </div>
</div>

<div class="rg-wrap">
    <div class="rg-card">
        <h2 class="rg-title">Crear cuenta</h2>
        <p class="rg-subtitle">Complete sus datos para registrarse</p>

        <form action="@Url.Action("Register", "Home")" method="post">
            <div class="rg-group">
                <input type="text" class="rg-input" name="nombre" placeholder="Nombre" required>
            </div>

            <div class="rg-group">
                <input type="text" class="rg-input" name="apellidos" placeholder="Apellidos" required>
            </div>

            <div class="rg-group">
                <input type="email" class="rg-input" name="email" placeholder="Correo electrónico" required>
            </div>

            <div class="rg-group">
                <input type="password" class="rg-input" name="password" placeholder="Contraseña" required>
            </div>

            <div class="rg-group">
                <input type="password" class="rg-input" name="confirmPassword" placeholder="Confirmar contraseña" required>
            </div>

            <button type="submit" class="rg-btn">Crear cuenta</button>

            <p class="rg-link">
                ¿Ya tiene cuenta? <a href="@Url.Action("Login", "Home")">Inicie sesión</a>
            </p>
        </form>
    </div>
</div>