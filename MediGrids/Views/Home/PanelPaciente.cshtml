@{
    ViewBag.Title = "Panel Paciente";
    Layout = "~/Views/Shared/_LayoutPaciente.cshtml";
}

<link rel="stylesheet" href="~/Template/css/panelpacientes.css" />

<section class="paciente-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1>Panel del Paciente</h1>
                <p>Bienvenido, @Session["UserEmail"]. Desde aquí puedes consultar la biblioteca de ejercicios y acceder a las opciones disponibles para tu perfil.</p>
            </div>
        </div>
    </div>
</section>

<section class="paciente-section">
    <div class="container">
        <div class="row g-4">

            <div class="col-lg-4 col-md-6 col-12">
                <div class="paciente-card">
                    <div class="paciente-icon">
                        <i class="lni lni-user"></i>
                    </div>
                    <h4>Mi Perfil</h4>
                    <p>
                        Consulta la información general de tu cuenta y tu acceso dentro de MediGrids.
                    </p>
                    <a href="@Url.Action("MiPerfilPaciente", "Home")" class="btn btn-success">
                        Ingresar
                    </a>
                </div>
            </div>


            <div class="col-lg-4 col-md-6 col-12">
                <div class="paciente-card">
                    <div class="paciente-icon">
                        <i class="lni lni-calendar"></i>
                    </div>
                    <h4>Agendar Cita</h4>
                    <p>
                        Revisa y gestiona tus citas disponibles dentro del sistema.
                    </p>
                    <a href="@Url.Action("AgendarCitas", "Paciente")" class="btn btn-success">
                        Ingresar
                    </a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 col-12">
                <div class="paciente-card">
                    <div class="paciente-icon">
                        <i class="lni lni-book"></i>
                    </div>
                    <h4>Biblioteca de Ejercicios</h4>
                    <p>
                        Consulta ejercicios terapéuticos clasificados por tipo de terapia y categoría clínica.
                    </p>
                    <a href="@Url.Action("BibliotecaEjercicios", "Home")" class="btn btn-success">
                        Ingresar
                    </a>
                </div>
            </div>




            <div class="col-lg-4 col-md-6 col-12">
                <div class="paciente-card">
                    <div class="paciente-icon">
                        <i class="lni lni-list"></i>
                    </div>
                    <h4>Mis Citas</h4>
                    <p>
                        Consulta el historial de tus citas agendadas y cancela las que ya no necesites.
                    </p>
                    <a href="@Url.Action("MisCitas", "Paciente")" class="btn btn-success">
                        Ingresar
                    </a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 col-12">
                <div class="paciente-card">
                    <div class="paciente-icon">
                        <i class="lni lni-list"></i>
                    </div>
                    <h4>Mis Ejercicios</h4>
                    <p>Consulta los ejercicios asignados a tu tratamiento.</p>
                    <a href="@Url.Action("MisEjerciciosAsignados", "Home")" class="btn btn-success">
                        Ingresar
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>