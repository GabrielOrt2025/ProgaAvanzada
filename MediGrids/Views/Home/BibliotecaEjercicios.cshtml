@model List<MediGrids.EntityFramework.Ejercicio>

@{
    ViewBag.Title = "Biblioteca de Ejercicios";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
    var terapias = ViewBag.Terapias as List<MediGrids.EntityFramework.TipoTerapia>;
    var categorias = ViewBag.Categorias as List<MediGrids.EntityFramework.CategoriaClinica>;
}

<link href="~/Template/css/BibliotecaEjercicios.css" rel="stylesheet" />

<section class="container mt-5 pt-5">
    <div class="biblioteca-header-box">
        <h1>Biblioteca de Ejercicios</h1>
        @{
            var categoriasCompletas = ViewBag.CategoriasCompletas as List<MediGrids.EntityFramework.CategoriaClinica>;
        }

        <form action='@Url.Action("BibliotecaEjercicios", "Home")' method="get">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label for="idTerapia">Tipo de terapia</label>
                    <select name="idTerapia" id="idTerapia" class="form-control">
                        <option value="">-- Seleccione una terapia --</option>
                        @if (terapias != null)
                        {
                            foreach (var t in terapias)
                            {
                                <option value="@t.id_terapia" @(ViewBag.IdTerapia != null && Convert.ToInt32(ViewBag.IdTerapia) == t.id_terapia ? "selected=\"selected\"" : "")>
                                    @t.nombre
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="idCategoria">Categoría clínica</label>
                    <select name="idCategoria" id="idCategoria" class="form-control">
                        <option value="">-- Seleccione una categoría --</option>
                        @if (categorias != null)
                        {
                            foreach (var c in categorias)
                            {
                                <option value="@c.id_categoria" @(ViewBag.IdCategoria != null && Convert.ToInt32(ViewBag.IdCategoria) == c.id_categoria ? "selected=\"selected\"" : "")>
                                    @c.nombre
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <input type="submit" value="Filtrar" class="btn btn-light me-2" />
                    <a href='@Url.Action("BibliotecaEjercicios", "Home")' class="btn btn-secondary">Limpiar</a>
                </div>
            </div>
        </form>
    </div>

    <div class="vista-toggle">
        <button type="button" id="btnVistaTabla" class="btn btn-success btn-sm">Lista</button>
        <button type="button" id="btnVistaCards" class="btn btn-outline-success btn-sm">Videos</button>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div id="vistaTabla" class="tabla-box">
            <table id="TablaBibliotecaEjercicios" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Objetivo terapéutico</th>
                        <th>Dificultad</th>
                        <th>Categoría clínica</th>
                        <th>Video</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.nombre</td>
                            <td>@item.descripcion</td>
                            <td>@item.objetivo</td>
                            <td>@item.dificultad</td>
                            <td>@(item.CategoriaClinica != null ? item.CategoriaClinica.nombre : "")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.video_url))
                                {
                                    <button type="button"
                                            class="btn btn-primary btn-sm btn-ver-video"
                                            data-bs-toggle="modal"
                                            data-bs-target="#videoModal"
                                            data-video="@item.video_url"
                                            data-nombre="@item.nombre">
                                        Ver video
                                    </button>
                                }
                                else
                                {
                                    <span>No disponible</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="vistaCards" class="d-none">
            <div class="row">
                @foreach (var item in Model)
                {
                    var embedUrl = "";

                    if (!string.IsNullOrEmpty(item.video_url))
                    {
                        if (item.video_url.Contains("youtube.com/watch?v="))
                        {
                            var videoId = item.video_url.Split(new[] { "watch?v=" }, StringSplitOptions.None)[1];
                            if (videoId.Contains("&"))
                            {
                                videoId = videoId.Split('&')[0];
                            }
                            embedUrl = "https://www.youtube.com/embed/" + videoId;
                        }
                        else if (item.video_url.Contains("youtu.be/"))
                        {
                            var videoId = item.video_url.Split(new[] { "youtu.be/" }, StringSplitOptions.None)[1];
                            if (videoId.Contains("?"))
                            {
                                videoId = videoId.Split('?')[0];
                            }
                            embedUrl = "https://www.youtube.com/embed/" + videoId;
                        }
                    }

                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="ejercicio-card">
                            <div class="ejercicio-card-thumb">
                                @if (!string.IsNullOrEmpty(embedUrl))
                                {
                                    <iframe src="@embedUrl"
                                            title="Video de @item.nombre"
                                            frameborder="0"
                                            allowfullscreen>
                                    </iframe>
                                }
                                else
                                {
                                    <div class="sin-thumb">Sin video</div>
                                }
                            </div>

                            <div class="ejercicio-card-body">
                                <h5>@item.nombre</h5>
                                <p class="descripcion">@item.descripcion</p>
                                <p><strong>Objetivo:</strong> @item.objetivo</p>
                                <p><strong>Dificultad:</strong> @item.dificultad</p>
                                <p><strong>Categoría:</strong> @(item.CategoriaClinica != null ? item.CategoriaClinica.nombre : "")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            No hay ejercicios disponibles con los filtros seleccionados.
        </div>
    }
</section>

<div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="videoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content video-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="videoModalLabel">Video del ejercicio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <iframe id="videoFrame"
                        src=""
                        allowfullscreen
                        style="width:100%; height:420px; border:none; border-radius:10px;">
                </iframe>
            </div>
        </div>
    </div>
</div>

<script>
    const categoriasCompletas = @Html.Raw(
        Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CategoriasCompletas ?? new List<object>())
    );

    const categoriaSeleccionada = '@(ViewBag.IdCategoria ?? "")';
</script>

<script src="~/Template/js/BibliotecaEjercicios.js"></script>

<script src="~/Template/js/BibliotecaEjercicios.js"></script>