@model MediGrids.EntityFramework.Paciente

@{
    ViewBag.Title = "Mi Perfil";
    Layout = "~/Views/Shared/_LayoutPaciente.cshtml";
}

<link rel="stylesheet" href="~/Template/css/panelpacientes.css" />

<section class="paciente-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1>Mi Perfil</h1>
                <p>
                    Consulta tu información personal y mantén tus datos actualizados.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="paciente-section">
    <div class="container">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">@TempData["MensajeExito"]</div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger">@TempData["MensajeError"]</div>
        }

        <div class="paciente-card" style="max-width: 900px; margin: 0 auto;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="mb-0">Información personal</h3>
                <a href="@Url.Action("EditarMiPerfilPaciente", "Home")" class="btn btn-success">
                    Editar información
                </a>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Nombre</label>
                    <div class="form-control bg-light">@Model.nombre</div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Apellidos</label>
                    <div class="form-control bg-light">@Model.apellidos</div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Correo</label>
                    <div class="form-control bg-light">@Model.email</div>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Teléfono</label>
                    <div class="form-control bg-light">
                        @(string.IsNullOrWhiteSpace(Model.telefono) ? "No registrado" : Model.telefono)
                    </div>
                </div>

       

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold">Estado</label>
                    <div class="form-control bg-light">
                        @(Model.activo == true ? "Activo" : "Inactivo")
                    </div>
                </div>
            </div>

            <a href="@Url.Action("PanelPaciente", "Home")" class="btn btn-secondary">
                Volver al panel
            </a>
        </div>
    </div>
</section>