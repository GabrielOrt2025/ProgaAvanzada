@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Template/css/auth-login.css")" />

<div class="lg-breadcrumbs">
    <div class="container lg-inner">
        <h1 class="lg-title-top">Iniciar Sesión</h1>
        <div class="lg-crumb">
            <a href="@Url.Action("Index", "Home")">Inicio</a>
            &nbsp;>&nbsp;
            <span>Iniciar Sesión</span>
        </div>
    </div>
</div>

<div class="lg-wrap">
    <div class="lg-card">
        <h2 class="lg-title">Inicia sesión en tu cuenta</h2>

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-warning">@TempData["MensajeError"]</div>
        }
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success">@TempData["MensajeExito"]</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form action="@Url.Action("Login", "Home")" method="post">
            <div class="lg-group">
                <input type="email" class="lg-input" name="email" placeholder="Correo"
                       value="@(Request.Form["email"] ?? "")" required>
            </div>

            <div class="lg-group">
                <input type="password" class="lg-input" name="password" placeholder="Contraseña" required>
            </div>

            <div class="lg-remember-forgot">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe">
                    <label class="form-check-label" for="rememberMe">Recuérdame</label>
                </div>
                <a href="javascript:void(0)" class="lg-lost-pass">¿Olvidó su contraseña?</a>
            </div>

            <button type="submit" class="lg-btn">Iniciar sesión</button>

            <div class="lg-divider">O</div>

            <p class="lg-link">
                ¿No tiene cuenta? <a href="@Url.Action("Register", "Home")">Regístrese aquí</a>
            </p>
        </form>
    </div>
</div>